---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../content/projects/project-data";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Ian Mager">
  <!-- Hero -->
  <section class="hero">
    <canvas class="hero-dither" id="hero-dither" aria-hidden="true"></canvas>
    <div class="container hero-content">
      <p class="hero-greeting">Hi, I'm</p>
      <h1 class="hero-name">Ian Mager</h1>
      <h2 class="hero-role">Software Engineer</h2>
      <p class="hero-blurb">
        I build reliable software across the full stack, from data
        models to polished interfaces. I focus on clean architecture,
        thorough testing, and shipping work that holds up in production.
      </p>
      <div class="hero-actions">
        <a href={`${base}#projects`} class="btn btn-primary">Projects</a>
        <a href={`${base}resume.pdf`} class="btn btn-outline" target="_blank" rel="noopener">
          Resume
        </a>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section" id="skills">
    <div class="container">
      <h2 class="section-title">Skills</h2>
      <div class="skills-grid">
        <div class="skill-group">
          <h3 class="skill-group-title">Languages</h3>
          <div class="skill-tags">
            <span class="tag">TypeScript</span>
            <span class="tag">JavaScript</span>
            <span class="tag">Python</span>
            <span class="tag">C</span>
            <span class="tag">C++</span>
          </div>
        </div>
        <div class="skill-group">
          <h3 class="skill-group-title">Frameworks & Libraries</h3>
          <div class="skill-tags">
            <span class="tag">React</span>
            <span class="tag">Next.js</span>
            <span class="tag">Node.js</span>
            <span class="tag">Express</span>
            <span class="tag">Astro</span>
          </div>
        </div>
        <div class="skill-group">
          <h3 class="skill-group-title">Tools & Infrastructure</h3>
          <div class="skill-tags">
            <span class="tag">Git</span>
            <span class="tag">Docker</span>
            <span class="tag">GitHub Actions</span>
            <span class="tag">Linux</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="section" id="projects">
    <div class="container">
      <h2 class="section-title">Featured Projects</h2>
      {projects.length > 0 ? (
        <div class="projects-grid">
          {projects.map((project) => (
            <ProjectCard {...project} />
          ))}
        </div>
      ) : (
        <p class="projects-empty">Projects coming soon.</p>
      )}
    </div>
  </section>

  <!-- Contact -->
  <section class="section" id="contact">
    <div class="container">
      <h2 class="section-title">Contact Me</h2>
      <p class="contact-text">
        I'm open to new opportunities and always happy to connect. Feel free to
        reach out via email or find me on the platforms below.
      </p>
      <div class="contact-links">
        <a href="mailto:MagerIan@outlook.com" class="contact-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          Email
        </a>
        <a href="https://github.com/ianmager" target="_blank" rel="noopener" class="contact-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
          </svg>
          GitHub
        </a>
        <a href="https://www.linkedin.com/in/ian-mager-9aa1323b8/" target="_blank" rel="noopener" class="contact-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
            <rect x="2" y="9" width="4" height="12" />
            <circle cx="4" cy="4" r="2" />
          </svg>
          LinkedIn
        </a>
      </div>
    </div>
  </section>
  <script>
    import { mountHeroDither } from "../scripts/hero-dither";

    const heroCanvas = document.getElementById("hero-dither");
    if (heroCanvas instanceof HTMLCanvasElement) mountHeroDither(heroCanvas);
  </script>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 7rem 0 7rem;
    background: var(--color-bg);
  }

  .hero-dither {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-shadow: 2px 2px 0 var(--color-bg);
  }

  .hero-greeting {
    font-family: var(--font-pixel);
    color: var(--color-accent);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .hero-greeting::before {
    content: "> ";
  }

  .hero-name {
    font-family: var(--font-pixel);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    color: var(--color-text);
    text-shadow:
      4px 4px 0 var(--color-accent-deep),
      8px 8px 0 var(--color-bg);
  }

  .hero-role {
    font-family: var(--font-pixel);
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    font-weight: 400;
    color: var(--color-accent-hover);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .hero-role::after {
    content: "_";
    margin-left: 0.15em;
    animation: cursor-blink 1s steps(1) infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .hero-blurb {
    max-width: 540px;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.75;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    gap: 1.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.4rem;
    border-radius: 0;
    font-family: var(--font-pixel);
    font-size: 0.9rem;
    text-transform: uppercase;
    text-shadow: none;
    box-shadow: var(--shadow-hard);
    transition: transform 0.1s steps(2), box-shadow 0.1s steps(2), background 0.1s steps(2);
  }

  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-accent-deep);
  }

  .btn:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--color-accent-deep);
  }

  .btn-primary {
    background: var(--color-accent-strong);
    border: 2px solid var(--color-accent-strong);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }

  .btn-outline {
    border: 2px solid var(--color-accent);
    background: var(--color-bg);
    color: var(--color-accent);
  }

  .btn-outline:hover {
    background:
      conic-gradient(var(--color-accent-deep) 25%, transparent 0 50%, var(--color-accent-deep) 0 75%, transparent 0) 0 0 / 4px 4px,
      var(--color-bg);
    color: var(--color-accent-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-role::after {
      animation: none;
    }
  }

  .projects-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .skills-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skill-group {
    padding: 1.1rem 1.1rem 1.25rem;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-hard);
  }

  .skill-group-title {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.85rem;
    font-weight: 400;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .projects-empty {
    color: var(--color-text-muted);
    font-style: italic;
    font-size: 0.95rem;
  }

  .contact-text {
    color: var(--color-text-muted);
    max-width: 480px;
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }

  .contact-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    border: 2px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    text-transform: uppercase;
    box-shadow: var(--shadow-hard);
    transition: transform 0.1s steps(2), box-shadow 0.1s steps(2), border-color 0.1s steps(2);
  }

  .contact-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-hover);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-accent-deep);
  }
</style>
