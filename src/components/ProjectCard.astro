---
interface Props {
  title: string;
  description: string;
  stack: string[];
  impact: string;
  image?: string;
  repo?: string;
  demo?: string;
  link?: string;
}

const { title, description, stack, impact, image, repo, demo, link } = Astro.props;

const base = import.meta.env.BASE_URL;
const imageSrc = image ? `${base}${image}` : undefined;
const primaryLink = link ?? demo ?? repo;
---

<article class="project-card" data-flipped="false">
  <div class="project-card-inner">
    <button
      type="button"
      class:list={["project-card-face", "project-card-front", { "project-card-front--has-image": imageSrc }]}
      data-flip-open
      aria-label={`${title} — view details`}
    >
      {imageSrc ? (
        <>
          <img src={imageSrc} alt="" class="project-card-thumb" loading="lazy" />
          <span class="project-card-front-overlay">
            <span class="project-card-title">{title}</span>
            <span class="project-card-hint">Click to flip</span>
          </span>
        </>
      ) : (
        <>
          <span class="project-card-title">{title}</span>
          <span class="project-card-hint">Click to flip</span>
        </>
      )}
    </button>

    <div
      class="project-card-face project-card-back"
      data-flip-close
      aria-hidden="true"
      role="button"
      tabindex="-1"
      aria-label={`${title} — back to preview`}
    >
      <h3 class="project-card-back-title">{title}</h3>

      <div class="project-card-back-scroll">
        <div class="project-card-section">
          <span class="project-card-label">Description</span>
          {description ? (
            <p class="project-card-text">{description}</p>
          ) : (
            <p class="project-card-placeholder">Short description coming soon.</p>
          )}
        </div>

        <div class="project-card-section">
          <span class="project-card-label">Impact</span>
          {impact ? (
            <p class="project-card-text project-card-impact">{impact}</p>
          ) : (
            <p class="project-card-placeholder">Impact details coming soon.</p>
          )}
        </div>

        {stack.length > 0 && (
          <div class="project-card-section">
            <span class="project-card-label">Stack</span>
            <div class="project-card-stack">
              {stack.map((tech) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
          </div>
        )}

        <div class="project-card-section">
          <span class="project-card-label">Link</span>
          {primaryLink ? (
            <a
              href={primaryLink}
              target="_blank"
              rel="noopener"
              class="project-card-link"
              data-no-flip
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
              Visit
            </a>
          ) : (
            <p class="project-card-placeholder">Link coming soon.</p>
          )}
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    perspective: 1200px;
  }

  .project-card-inner {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-card[data-flipped="true"] .project-card-inner {
    transform: rotateY(180deg);
  }

  .project-card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-card);
    color: var(--color-text);
    overflow: hidden;
    transform-style: preserve-3d;
  }

  .project-card-front {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    font: inherit;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
    transform: rotateY(0deg);
  }

  .project-card-front--has-image {
    padding: 0;
    gap: 0;
  }

  .project-card-thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translateZ(0);
  }

  .project-card-front-overlay {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    padding: 1rem;
    background: linear-gradient(
      to top,
      rgba(15, 23, 42, 0.92) 0%,
      rgba(15, 23, 42, 0.4) 45%,
      transparent 100%
    );
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translateZ(0);
  }

  .project-card-front--has-image .project-card-title {
    color: var(--color-text);
    text-align: center;
  }

  .project-card-front--has-image:hover .project-card-title,
  .project-card-front--has-image:focus-visible .project-card-title {
    color: var(--color-accent);
  }

  .project-card-front--has-image .project-card-hint {
    color: var(--color-text-muted);
  }

  .project-card[data-flipped="true"] .project-card-front {
    pointer-events: none;
    visibility: hidden;
  }

  .project-card[data-flipped="false"] .project-card-back {
    visibility: hidden;
  }

  .project-card-front:hover,
  .project-card-front:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
    outline: none;
  }

  .project-card-title {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .project-card-hint {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .project-card-front:hover .project-card-hint,
  .project-card-front:focus-visible .project-card-hint {
    opacity: 1;
  }

  .project-card-back {
    transform: rotateY(180deg) translateZ(1px);
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background: var(--color-bg-card);
    cursor: pointer;
  }

  .project-card[data-flipped="true"] .project-card-back {
    pointer-events: auto;
  }

  .project-card-back[aria-hidden="true"] {
    pointer-events: none;
    cursor: default;
  }

  .project-card-back-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
    padding-right: 0.5rem;
  }

  .project-card-back-scroll {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-right: 0.25rem;
  }

  .project-card-section {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .project-card-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-card-text {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .project-card-impact {
    color: var(--color-accent);
    font-weight: 500;
  }

  .project-card-placeholder {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .project-card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .project-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-accent);
    font-size: 0.9rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
    align-self: flex-start;
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .project-card-link:hover {
    border-bottom-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card-inner {
      transition: none;
    }

    .project-card-hint {
      transition: none;
    }
  }
</style>

<script>
  const setFlipped = (card: HTMLElement, flipped: boolean) => {
    card.setAttribute("data-flipped", flipped ? "true" : "false");
    const back = card.querySelector<HTMLElement>(".project-card-back");
    const front = card.querySelector<HTMLElement>(".project-card-front");
    if (back) {
      back.setAttribute("aria-hidden", flipped ? "false" : "true");
      back.setAttribute("tabindex", flipped ? "0" : "-1");
    }
    if (front) front.setAttribute("aria-hidden", flipped ? "true" : "false");
  };

  document.querySelectorAll<HTMLButtonElement>("[data-flip-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest<HTMLElement>(".project-card");
      if (card) setFlipped(card, true);
    });
  });

  document.querySelectorAll<HTMLElement>("[data-flip-close]").forEach((back) => {
    back.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.closest("[data-no-flip]")) return;

      const card = back.closest<HTMLElement>(".project-card");
      if (card) setFlipped(card, false);
    });

    back.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      const target = event.target as HTMLElement;
      if (target.closest("[data-no-flip]")) return;

      event.preventDefault();
      const card = back.closest<HTMLElement>(".project-card");
      if (card) setFlipped(card, false);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-no-flip]").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.stopPropagation();
    });
  });
</script>
