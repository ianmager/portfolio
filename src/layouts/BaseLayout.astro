---
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/silkscreen/latin-400.css";
import "@fontsource/silkscreen/latin-700.css";
import silkscreenBold from "@fontsource/silkscreen/files/silkscreen-latin-700-normal.woff2?url";
import jetbrainsMono from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Ian Mager — Software Engineer Portfolio" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={silkscreenBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMono} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <header class="header">
      <nav class="container nav">
        <a href={base} class="nav-logo">IM</a>
        <ul class="nav-links">
          <li><a href={`${base}#projects`}>Projects</a></li>
          <li><a href={`${base}#skills`}>Skills</a></li>
          <li><a href={`${base}#contact`}>Contact</a></li>
          <li class="nav-resume-item">
            <a href={`${base}resume.pdf`} class="nav-resume" target="_blank" rel="noopener">
              Resume
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <p>&copy; {new Date().getFullYear()} Ian Mager</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
  }

  /* Dithered bottom edge: 50% checker fading into 25% dots */
  .header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 8px;
    background:
      conic-gradient(var(--color-bg) 25%, transparent 0 50%, var(--color-bg) 0 75%, transparent 0) 0 0 / 4px 4px repeat-x,
      conic-gradient(var(--color-bg) 25%, transparent 0) 0 4px / 4px 4px repeat-x;
    pointer-events: none;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }

  .nav-logo {
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-bg);
    background: var(--color-accent-strong);
    padding: 0 0.4rem;
    line-height: 1.6;
    box-shadow: var(--shadow-hard);
  }

  .nav-logo:hover {
    color: var(--color-bg);
    background: var(--color-accent);
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 1.75rem;
    align-items: center;
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  .nav-links a {
    position: relative;
    color: var(--color-text-muted);
  }

  .nav-links a:hover {
    color: var(--color-accent-hover);
  }

  .nav-links a:not(.nav-resume):hover::before {
    content: ">";
    position: absolute;
    right: calc(100% + 0.3em);
    color: var(--color-accent);
  }

  .nav-resume {
    padding: 0.2rem 0.85rem;
    border: 2px solid var(--color-accent);
    color: var(--color-accent) !important;
    box-shadow: var(--shadow-hard);
    transition: transform 0.1s steps(2), box-shadow 0.1s steps(2);
  }

  .nav-resume:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: #fff !important;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-accent-deep);
  }

  .footer {
    position: relative;
    padding: 2rem 0;
    margin-top: 2rem;
  }

  .footer::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 8px;
    background:
      conic-gradient(var(--color-border) 25%, transparent 0) 0 0 / 4px 4px repeat-x,
      conic-gradient(var(--color-border) 25%, transparent 0 50%, var(--color-border) 0 75%, transparent 0) 0 4px / 4px 4px repeat-x;
  }

  .footer-inner {
    text-align: center;
    color: var(--color-text-muted);
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .nav-links {
      gap: 0.9rem;
      font-size: 0.72rem;
    }
  }

  /* The hero already has a Resume button, so drop the nav copy when space runs out */
  @media (max-width: 480px) {
    .nav-resume-item {
      display: none;
    }
  }
</style>

<style is:global>
  @import "../styles/global.css";
</style>
